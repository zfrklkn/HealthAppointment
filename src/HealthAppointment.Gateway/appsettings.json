{
  "ReverseProxy": {
    "Routes": {
      "appointment-route": {
        "ClusterId": "appointment-cluster",
        "Match": {
          "Path": "/api/appointments/{**catch-all}"
        }
      },
      "doctor-route": {
        "ClusterId": "doctor-cluster",
        "Match": {
          "Path": "/api/doctors/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "appointment-cluster": {
        "Destinations": {
          "appointment-api": {
            "Address": "https://localhost:7127/"
          }
        }
      },
      "doctor-cluster": {
        "Destinations": {
          "doctor-api": {
            "Address": "https://localhost:7227/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}