{
  "ReverseProxy": {
    "Routes": {
      "appointment-route": {
        "ClusterId": "appointment-cluster",
        "Match": {
          "Path": "/api/appointments/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "appointment-cluster": {
        "Destinations": {
          "appointment-api": {
            "Address": "https://localhost:7127/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
